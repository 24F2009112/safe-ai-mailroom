# AI extraction (recommended for natural-language case files)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Set exactly one receipt-verification mechanism if the receipt issuer supports it.
# HMAC receipts should be signed using compact canonical JSON (sorted keys, no spaces,
# UTF-8) of every receipt field EXCEPT signature/signature_algorithm/algorithm/verified.
RECEIPT_HMAC_SECRET=
# Or use a PEM-encoded Ed25519 public key (store as one line with \n between lines).
RECEIPT_PUBLIC_KEY=

# Set to the public Render URL after deployment, without a trailing slash.
PUBLIC_BASE_URL=
DATABASE_PATH=./mailroom_audit.sqlite3
AI_TIMEOUT_SECONDS=6
AI_CONCURRENCY=16
CASE_FILE_TIMEOUT_SECONDS=5
